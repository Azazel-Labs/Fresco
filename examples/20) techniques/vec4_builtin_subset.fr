// Basic example: vec4 + shader-style builtin subset (scalar/vector forms).

canvas vec4_builtin_subset(ctx: CanvasContext) -> color {
    let uv = context(coord)
    let time = context(time)
    let dt = context(delta_time)
    let p = uv - (0.5, 0.5)
    let r2 = dot(p, p)
    let phase = frac(time * 0.25 + dt * 0.0)

    let v4 = (
        0.5 + 0.5 * sin(time + p.x * 8.0),
        0.5 + 0.5 * sin(time * 1.3 + p.y * 9.0),
        0.5 + 0.5 * sin(time * 1.7 + (p.x + p.y) * 7.0),
        1.0
    )

    let lo4 = (0.12, 0.10, 0.14, 1.0)
    let hi4 = (0.95, 0.90, 0.98, 1.0)
    let t4 = (phase, phase * 0.8, phase * 1.2, 0.0)

    let mixed = mix(lo4, hi4, phase)
    let remixed = lerp(v4, mixed, t4)
    let bounded = clamp(remixed, lo4, hi4)
    let squashed = saturate(pow(bounded, 1.2))

    let gain = max(0.2, 1.0 - sqrt(r2) * 1.8)
    let floor4 = max(squashed, 0.05)
    let out4 = min(floor4 * gain + (0.0, 0.0, 0.0, 1.0), 1.0)

    compose {
        rgba(r: out4.r, g: out4.g, b: out4.b, a: 1.0)
    }
}
