// Basic example: HLSL-style builtin compatibility surface.
// Exercises aliases and helpers: lerp, frac, saturate, rcp, rsqrt,
// ddx, ddy, fwidth, plus geometric ops distance/cross/reflect/refract.

canvas hlsl_builtin_subset(ctx: CanvasContext) -> color {
    let uv = context(coord)
    let time = context(time)
    let center = (0.5, 0.5)
    let d = uv - center
    let r2 = dot(d, d)
    let radial = sqrt(r2)

    let phase = frac(time * 0.12 + distance(uv, center) * 1.8)
    let base = lerp(0.08, 0.92, saturate(phase))

    let pulse = sin(radial * 90.0 - time * 2.6)
    let aa = fwidth(pulse)
    let edge = abs(pulse)
    let ring = 1.0 - smoothstep(0.0, aa * 1.6 + 0.0006, edge)

    let gx = ddx(pulse)
    let gy = ddy(pulse)
    let slope = saturate((abs(gx) + abs(gy)) * 0.65)

    let incident = normalize((sin(time * 0.7), -1.0))
    let normal = normalize(d + (0.0, 0.001))
    let reflected = reflect(incident, normal)
    let refracted = refract(incident, normal, 0.82)
    let turn = abs(cross(incident, normal))
    let spec = saturate(dot(reflected, normalize((0.35, 0.94))))
    let bend = saturate(length(refracted))

    let inv = rcp(1.0 + radial * 7.0)
    let soft = rsqrt(1.0 + r2 * 26.0)

    compose {
        fill(rgba(
            r: saturate(0.06 + ring * 0.78 + spec * 0.28 + soft * 0.16),
            g: saturate(0.10 + base * 0.72 + turn * 0.22),
            b: saturate(0.14 + bend * 0.44 + inv * 0.36 + slope * 0.34),
            a: 1.0
        ))
    }
}
