// Gallery: layered cloud decks — demonstrates `fn -> layer` helpers and
// `field expr at coord` for finite-difference bump lighting.
//
// Each cloud deck is built by `fn cloud_deck`, a typed helper that captures
// canvas params and returns a fully-formed, opacity-masked layer.  The slope
// estimate uses `field fbm(…) at (coord + offset)` — explicit resampling of
// the fbm field at a neighbour coordinate — rather than manually duplicating
// the offset calculation.
//
// Graduated from examples/99) future/01-cloudscape.fr (rung 1).
//
// --explain reports:
//   6 fbm evaluations (base + bump per deck), all point-locality
//   locality: all nodes point after rewrites ⇒ 1 fused fragment pass
//   zero pass splits

canvas cloudscape(ctx: CanvasContext) -> color {
    let time = context(time)
    param coverage: f32 = 0.55 in 0 .. 1
    param wind: f32 = 0.02 in 0 .. 0.1
    param sun_dir: f32 = 0.6 in 0 .. 1
    param parallax_gain: f32 = 1.0 in 0 .. 2
    param normal_gain: f32 = 1.0 in 0 .. 3

    // fn returning layer: the deck factory is a typed helper that captures
    // canvas params and returns a fully formed, opacity-masked layer.
    fn cloud_deck(scale: f32, speed: f32, softness: f32, tint: color) -> layer {
        let drift = (time * speed, time * speed * 0.13)

        // Cloud density at the current pixel.
        let base = field fbm(coord * scale + drift)
        let dens = field smoothstep(0.0, softness, base - (1.0 - coverage))

        // `field X at Y` — resample the fbm field at a small coord-space offset
        // to estimate the surface slope for bump lighting.  The `at` operator makes
        // the intent explicit — "evaluate this field expression at a different
        // coordinate" — rather than manually duplicating the offset calculation.
        // The offset `(e, 0.0)` in coord space maps to `(e * scale, 0.0)` in
        // fbm space, giving a finite-difference slope along the horizontal axis.
        let e = 0.004
        let bump  = field fbm(coord * scale + drift) at (coord + (e, 0.0))
        let slope = (
            bump -
            base) * (normal_gain / e
        )

        // Simple one-sided bump lighting from the estimated slope.
        let lit   = smoothstep(-0.8, 0.8,  sun_dir - slope)
        let shad  = smoothstep( 0.2, 0.9, -sun_dir + slope * 0.5 + 0.5)
        let cloud_color = mix(tint * 0.15, #ffffff, lit * 0.7 + 0.3) * shad

        layer cloud_color |> opacity(dens)
    }

    compose {
        fill(gradient(along: y, stops: [
                stop(at: 0.0,  color: #d9ebf7),
                stop(at: 0.54, color: #86bdee),
                stop(at: 1.0,  color: #315f9b),
        ]))
        circle(at: (0.72, 0.78), radius: 0.05) |> fill(#fff7dc)
        circle(at: (0.72, 0.78), radius: 0.05) |> glow(reach: 90px, strength: 0.5)

        // Three cloud decks at different parallax scales.
        in space scale(1.00 * parallax_gain, around: center) {
            cloud_deck(scale: 3.0 * parallax_gain, speed: wind * 0.5, softness: 0.55, tint: #9fb2c8) }
        in space scale(1.25 * parallax_gain, around: center) {
            cloud_deck(scale: 2.1 * parallax_gain, speed: wind * 0.9, softness: 0.45, tint: #a8bcd2) }
        in space scale(1.60 * parallax_gain, around: center) {
            cloud_deck(scale: 1.3 * parallax_gain, speed: wind * 1.5, softness: 0.32, tint: #b4c6da) }
    }
}
