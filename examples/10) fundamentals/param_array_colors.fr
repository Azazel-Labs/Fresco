// Example: Color array parameters
// Shows how to use array<color, N> for color palettes

canvas demo(ctx: CanvasContext) -> color {
    param palette: array<color, 5> = [#ef4444, #f59e0b, #10b981, #3b82f6, #8b5cf6]

    compose {
        fill(#f9fafb)

        // Create colored circles from palette
        for c in palette {
            circle(at: (0.0, 0.0), radius: 0.2)
            |> fill(c)
        }
    }
}
