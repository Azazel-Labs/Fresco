// Basic example: smoothing + wide-effect warnings.
// Intentionally applies wide effects to a smoothed (non-lipschitz-exact) shape.

canvas effects_smooth_warning(ctx: CanvasContext) -> color {
    space stage = centered(aspect: preserve)

    let a = circle(at: (0.42, 0.5), radius: 0.13)
    let b = box(at: (0.58, 0.5), size: (0.22, 0.18)) |> round(radius: 0.05)
    let joined = (
        a |
        b) |> smooth(radius: 0.04
    )

    compose {
        fill(gradient(
            along: y,
            stops: [
                stop(at: 0.0, color: #0b1324),
                stop(at: 1.0, color: #14233f),
            ]
        ))

        in space stage {
            joined |> shadow(offset: (0.012, -0.012), soften: 0.03, color: #00000088)
            joined |> glow(reach: 0.06, strength: 0.7, color: #7dd3fc66) |> blend(add)
            joined |> fill(#93c5fd)
        }
    }
}
