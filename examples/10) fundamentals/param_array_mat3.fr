// Demonstrates mat3 array parameters - 3D transformations

canvas demo(ctx: CanvasContext) -> color {
    let uv = context(coord)
    param transforms: array<mat3, 2> = [
        mat3(vec3(1.0, 0.0, 0.0), vec3(0.0, 1.0, 0.0), vec3(0.0, 0.0, 1.0)),
        mat3(vec3(1.2, 0.0, 0.0), vec3(0.0, 1.2, 0.0), vec3(-0.1, -0.1, 1.0))
    ]

    compose {
        fill(#faf5ff)

        for mat in transforms {
            let pos = vec3(uv, 1.0);
            let transformed = mat * pos;
            circle(at: transformed.xy, radius: 0.12)
            |> fill(#8b5cf6)
            |> opacity(0.5)
        }
    }
}
