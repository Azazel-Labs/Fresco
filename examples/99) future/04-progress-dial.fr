// north-star: progress-dial — polar space + gradient flowing along the arc
// status: aspirational
// rung: 2 (dial), 7 (anchor: path), text stubbed until paths land
// deltas:
//   - `anchor: path` gradient mode on curve-backed shapes (design doc anchoring proposal)
//   - turn-fraction wrap at x = 0/1 in polar space (same bleed policy as repeat)
//   - text(...) — STUB, requires paths (ext §23.3); comment out for first pass
// done when: gradient flows around the arc (not across it); scrubbing `progress`
//   in the workbook animates the ring; wrap seam at 12 o'clock is invisible.

canvas progress_dial(ctx: CanvasContext) -> color {
    param progress: f32 = 0.72 in 0 .. 1
    let eased = ramp(from: 0s, over: 1.1s, ease: out_cubic) * progress

    space dial = polar(center: center, from: -90deg, direction: clockwise)

    compose {
        fill(#0b0e17)
        in space dial {
            // in polar space: x is turn fraction (wraps), y is radius
            let track = box(at: (0.5, 0.36), size: (1.0, 0.028))
            let arc   = box(at: (eased / 2, 0.36), size: (eased, 0.028))

            track |> fill(#1f2937)
            arc |> round(0.014) |> fill(gradient(
                along: x, anchor: path,
                stops: [
                    stop(at: 0.0, color: #5eead4),
                    stop(at: 1.0, color: #3b82f6),
            ]))
            arc |> glow(reach: 10px, strength: 0.35)
        }
        // text(format("{:.0}%", eased * 100), at: center, size: 42px) |> fill(#e5e7eb)
    }
}
