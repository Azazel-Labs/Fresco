# Generated by Cargo
# will have compiled files and executables
/target/

# This workspace ships a CLI and playground: track the root lockfile so CI and
# local builds resolve the same dependencies. Ignore standalone nested lockfiles.
Cargo.lock
!/Cargo.lock

# These are backup files generated by rustfmt
**/*.rs.bk

# Node dependencies and caches anywhere in the workspace
node_modules/

# Web playground build artifacts
crates/fresco-wasm/web/dist/
crates/fresco-wasm/web/pkg/
crates/fresco-wasm/web/src/examples/
crates/fresco-wasm/web/src/generated/wasm-contracts/
crates/fresco-wasm/bindings/
crates/fresco-wasm/web/public/generated/language-reference.v1.json
crates/fresco-wasm/web/public/generated/language-reference.v1.md
crates/fresco-wasm/web/public/generated/language-reference.v1.html

# Generated language docs artifacts
docs/generated/language-reference.v1.json
docs/generated/language-reference.v1.md

# Copilot/RPI planning artifacts
.copilot-tracking/

/tmp

.claude/

# Standalone example engine WASM build outputs
integrations/example-engine-host/web/compiler/
integrations/example-engine-host/web/renderer/
integrations/example-engine-host/web/demo.fr
integrations/example-engine-host/web/mesh.fr
integrations/example-engine-host/web/particles.fr

# Shared example renderer distributed with playground builds
crates/fresco-wasm/web/public/example-engine-renderer/

integrations/example-engine-host/web/forward_plus.fr

integrations/example-engine-host/web/deferred.fr
