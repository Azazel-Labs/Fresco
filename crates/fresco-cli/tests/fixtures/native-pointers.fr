struct NativeRoots {
    input: Ptr<array<u32, 64>, Access.Read>
    output: Ptr<array<u32, 64>>
}
param roots: NativeRoots

fn transform(value: u32) -> u32 {
    return value * u32(3) + u32(7)
}

fn update_one(index: u32) {
    if index < u32(64) {
        let destination = roots.output
        (*destination)[index] = transform((*roots.input)[index])
    }
}
