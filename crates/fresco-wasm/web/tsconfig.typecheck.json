{
  "compilerOptions": {
    "allowJs": true,
    "checkJs": true,
    "noEmit": true,
    "strict": false,
    "skipLibCheck": true,
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "target": "ES2022",
    "lib": ["ES2022", "DOM", "WebWorker"],
    "types": ["vite/client"],
    "allowSyntheticDefaultImports": true,
    "jsx": "react-jsx",
    "jsxImportSource": "preact"
  },
  "include": [
    "src/vite-env.d.ts",
    "tests/readme/capture.ts",
    "tests/gpu/harness.ts",
    "tests/gpu/rust-engine-renderer.ts",
    "src/worker-protocol.ts",
    "src/compile-worker.ts",
    "src/worker-runtime.ts",
    "src/worker-retry.ts",
    "src/pass-plan.ts",
    "src/preview/helpers.ts",
    "src/preview/example-engine-module.ts",
    "src/preview/controls.ts",
    "src/runtime-param-aliases.ts",
    "src/completion-provider.ts",
    "src/manifest-contract.ts",
    "src/wgsl-entry.ts",
    "src/example-catalog.ts",
    "src/preview/uniforms.ts",
    "src/visualizer-renderer.ts",
    "src/shader-params-ui.ts",
    "src/builtin-help.ts",
    "src/viz-annotations.ts",
    "src/editor-monaco-adapter.ts",
    "src/preview/renderer-support.ts",
    "src/preview/param-codegen.ts",
    "src/preview/renderer-manifest.ts",
    "src/app/diagnostics-ui.ts",
    "src/app/param-editors/color-param-editor.tsx",
    "src/app/param-editors/matrix-param-editor.tsx",
    "src/app/param-editors/scalar-param-editors.tsx",
    "src/app/shader-param-view-model.ts",
    "src/app/source-url-codec.ts",
    "src/viz/viz-zone-manager.ts",
    "src/main.ts"
  ]
}
