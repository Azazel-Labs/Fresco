// Run with the native example host's --source option, or paste into its browser host.
canvas path_canvas(ctx: CanvasContext) -> color {
    param widths: array<f32> = [0.02]
    let curve = path {
        move (0.10, 0.30)
        cubic (0.30, 0.85) (0.45, 0.05) (0.62, 0.55)
        arc center: (0.72, 0.55) radius: 0.20 sweep: 360deg
    }
    compose { curve |> stroke(width: widths[0]) }
}
