surface adjustable(sp: surf) -> material(unlit) {
    param tint: color = #ff0000
    param gain: f32 = 1.0 in 0.0 .. 1.0
    param enabled: bool = true
    param steps: i32 = 3
    compose {
        base(albedo: rgba(tint.r * gain, enabled ? tint.g : 0.0, steps == 3 ? tint.b : 0.0, tint.a))
    }
}
