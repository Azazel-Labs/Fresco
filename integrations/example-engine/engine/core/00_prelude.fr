tags pipeline { lighting }

// Explicit modulo-2^32 arithmetic for shader-side hashes. Host allocation
// expressions use checked arithmetic and do not call these shader helpers.
fn wrapping_add(a: u32, b: u32) -> u32 { return a + b }
fn wrapping_mul(a: u32, b: u32) -> u32 { return a * b }

// normalize_or(v, fallback) -> vec2
// Normalize a finite vec2; lengths <= 0.0001 return fallback unchanged.
// Scaling avoids squared-length overflow. Nonfinite inputs are outside the contract.
fn normalize_or(v: vec2, fallback: vec2) -> vec2 {
    let scale = max(max(abs(v.x), abs(v.y)), 0.0001)
    let scaled = v / scale
    let squared = dot(scaled, scaled)
    if scale <= 0.0001 && squared <= 1.0 { return fallback }
    return scaled * inverse_sqrt(max(squared, 1.0))
}

// normalize_or_zero(v) -> vec2
// Normalize a finite vec2; lengths <= 0.0001 return the zero vector.
fn normalize_or_zero(v: vec2) -> vec2 {
    return normalize_or(v, vec2(0.0))
}

// normalize_or(v, fallback) -> vec3
// Normalize a finite vec3; lengths <= 0.0001 return fallback unchanged.
// Scaling avoids squared-length overflow. Nonfinite inputs are outside the contract.
fn normalize_or(v: vec3, fallback: vec3) -> vec3 {
    let scale = max(max(max(abs(v.x), abs(v.y)), abs(v.z)), 0.0001)
    let scaled = v / scale
    let squared = dot(scaled, scaled)
    if scale <= 0.0001 && squared <= 1.0 { return fallback }
    return scaled * inverse_sqrt(max(squared, 1.0))
}

// normalize_or_zero(v) -> vec3
// Normalize a finite vec3; lengths <= 0.0001 return the zero vector.
fn normalize_or_zero(v: vec3) -> vec3 {
    return normalize_or(v, vec3(0.0))
}

// normalize_or(v, fallback) -> vec4
// Normalize a finite vec4; lengths <= 0.0001 return fallback unchanged.
// Scaling avoids squared-length overflow. Nonfinite inputs are outside the contract.
fn normalize_or(v: vec4, fallback: vec4) -> vec4 {
    let scale = max(max(max(max(abs(v.x), abs(v.y)), abs(v.z)), abs(v.w)), 0.0001)
    let scaled = v / scale
    let squared = dot(scaled, scaled)
    if scale <= 0.0001 && squared <= 1.0 { return fallback }
    return scaled * inverse_sqrt(max(squared, 1.0))
}

// normalize_or_zero(v) -> vec4
// Normalize a finite vec4; lengths <= 0.0001 return the zero vector.
fn normalize_or_zero(v: vec4) -> vec4 {
    return normalize_or(v, vec4(0.0))
}
// Required frame globals bound once by the host as a single uniform block.
// `time()`, `delta_time()`, and `resolution()` below — and the
// `signal`/`delta`/`resolution` entry parameter types — link to these fields.
struct FrameGlobals {
    @semantic(time) time: f32
    @semantic(delta_time) delta_time: f32
    @semantic(resolution) resolution: vec2
}

param frame: FrameGlobals

// time() -> f32
// Seconds elapsed since the shader started, read from the bound frame global.
fn time() -> f32 {
    return frame.time
}

// delta_time() -> f32
// Seconds elapsed since the previous frame, read from the bound frame global.
fn delta_time() -> f32 {
    return frame.delta_time
}

// resolution() -> vec2
// Canvas resolution in pixels, read from the bound frame global.
fn resolution() -> vec2 {
    return frame.resolution
}

// mask(lo, hi, x) -> f32
// Turn a scalar field into a 0..1 mask with smoothstep.
// - lo: lower threshold where the mask starts rising from 0.
// - hi: upper threshold where the mask reaches 1.
// - x: sampled scalar field value to threshold.
fn mask(lo: f32, hi: f32, x: f32) -> f32 {
    return smoothstep(lo, hi, x)
}

// remap01(lo, hi, x) -> f32
// Remap a scalar from [lo, hi] into the normalized 0..1 range.
// - lo: source range minimum.
// - hi: source range maximum.
// - x: value to normalize into 0..1.
fn remap01(lo: f32, hi: f32, x: f32) -> f32 {
    return clamp((x - lo) / max(hi - lo, 0.000001), 0.0, 1.0)
}

// band(lo, hi, feather, x) -> f32
// Create a soft band/window between two thresholds.
// - lo: point where the band begins.
// - hi: point where the band ends.
// - feather: softness used for both the rising and falling edges.
// - x: sampled scalar field value to window.
fn band(lo: f32, hi: f32, feather: f32, x: f32) -> f32 {
    let rise_hi = lo + feather
    let fall_lo = hi - feather
    return smoothstep(lo, rise_hi, x) * (1 - smoothstep(fall_lo, hi, x))
}

// grounded(height, falloff) -> f32
// Bias an effect toward lower surface heights.
// - height: normalized surface height where 0 is low and 1 is high.
// - falloff: height range over which the grounding fades out.
fn grounded(height: f32, falloff: f32) -> f32 {
    return smoothstep(0.0, falloff, 1.0 - height)
}

// erode(mask, by, strength) -> f32
// Erode a mask by another field and a strength factor.
// - mask: the original coverage mask to preserve or remove.
// - by: erosion driver, usually another 0..1 mask like damage or curvature.
// - strength: erosion amount, where larger values remove more of the mask.
fn erode(mask: f32, by: f32, strength: f32) -> f32 {
    return mask * (1.0 - by * strength)
}

// coverage(value, gain, bias, extra) -> f32
// Bias and grow a mask from a field with gain and extra contribution.
// - value: source field value that drives the resulting coverage.
// - gain: main multiplier applied to the source field.
// - bias: constant baseline coverage added before clamping.
// - extra: additional contribution, often driven by wear or another control.
fn coverage(value: f32, gain: f32, bias: f32, extra: f32) -> f32 {
    return clamp(bias + value * (gain + extra), 0.0, 1.0)
}

// sign_nonzero(x) -> f32
// Return -1 for negative inputs and +1 for zero or positive inputs.
fn sign_nonzero(x: f32) -> f32 {
    return x < 0.0 ? -1.0 : 1.0
}

// clamp01(x) -> f32
// Clamp a scalar into the normalized 0..1 range.
fn clamp01(x: f32) -> f32 {
    return clamp(x, 0.0, 1.0)
}

// color_mix(from, to, t) -> color
// Linearly blend two colors by `t`.
fn color_mix(from: color, to: color, t: f32) -> color {
    return mix(from, to, t)
}

// rgb(r, g, b) -> color
// Build an opaque sRGB color from red, green, and blue channels.
fn rgb(r: f32, g: f32, b: f32) -> color {
    return rgba(r: r, g: g, b: b, a: 1.0)
}

// grey(value) -> layer
// Build a grayscale layer from a scalar value.
fn grey(value: f32) -> layer {
    return fill(rgb(value, value, value))
}

// rgb24(packed: f32) -> color
// Decode a packed 24-bit RGB value from scalar input.
// This version sanitizes arbitrary scalar input through clamp+round.
fn rgb24(packed: f32) -> color {
    let c = clamp(floor(packed + 0.5), 0.0, 16777215.0)
    let r8 = bit_extract(c, 16.0, 8.0)
    let g8 = bit_extract(c, 8.0, 8.0)
    let b8 = bit_extract(c, 0.0, 8.0)

    return rgba(r: r8 / 255.0, g: g8 / 255.0, b: b8 / 255.0, a: 1.0)
}

// rgb24(packed: i32) -> color
// Decode packed 0xRRGGBB using integer-style specialization.
fn rgb24(packed: i32) -> color {
    let r8 = bit_extract(packed, 16.0, 8.0)
    let g8 = bit_extract(packed, 8.0, 8.0)
    let b8 = bit_extract(packed, 0.0, 8.0)

    return rgba(r: r8 / 255.0, g: g8 / 255.0, b: b8 / 255.0, a: 1.0)
}

// rgb24(packed: u32) -> color
// Decode packed 0xRRGGBB using unsigned integer specialization.
fn rgb24(packed: u32) -> color {
    let r8 = bit_extract(packed, 16.0, 8.0)
    let g8 = bit_extract(packed, 8.0, 8.0)
    let b8 = bit_extract(packed, 0.0, 8.0)

    return rgba(r: r8 / 255.0, g: g8 / 255.0, b: b8 / 255.0, a: 1.0)
}

// rgba32(packed: u32) -> color
// Decode packed 0xRRGGBBAA using unsigned integer specialization.
fn rgba32(packed: u32) -> color {
    let r8 = bit_extract(packed, 24.0, 8.0)
    let g8 = bit_extract(packed, 16.0, 8.0)
    let b8 = bit_extract(packed, 8.0, 8.0)
    let a8 = bit_extract(packed, 0.0, 8.0)

    return rgba(r: r8 / 255.0, g: g8 / 255.0, b: b8 / 255.0, a: a8 / 255.0)
}
