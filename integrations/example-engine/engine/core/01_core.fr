// Core engine vocabulary declarations: tags, groups, texture types, structs,
// material payloads, enums, and record layouts.

tags space { object, tangent, world, view, clip }
tags encoding { srgb, linear, aces_cg }

@allocate(parameters) @group(0) group material
@allocate(textures) @group(1) group textures
@allocate(storage) @group(2) group draw
@allocate(globals) @group(3) group frame
@group(4) group pass

texture_type AlbedoRGB -> color {
	r: red
	g: green
	b: blue
	return rgb(red, green, blue)
}

texture_type RoughnessR {
	r: roughness
}

texture_type NormalGL -> vec3 in tangent {
	r: nx = raw * 2.0 - 1.0
	g: ny = raw * 2.0 - 1.0
	b: nz = raw * 2.0 - 1.0
	return normalize(vec3(nx, ny, nz))
}

texture_type NormalObject -> vec3 in object {
	r: nx = raw * 2.0 - 1.0
	g: ny = raw * 2.0 - 1.0
	b: nz = raw * 2.0 - 1.0
	return normalize(vec3(nx, ny, nz))
}

texture_type LightmapRGBM -> vec3 {
	r: r
	g: g
	b: b
	a: m
	return vec3(r, g, b) * (m * 8.0)
}

texture_type LightmapDirGL -> vec4 {
	r: x
	g: y
	b: z
	a: w
	return vec4(x, y, z, w)
}

texture_type CookieR -> f32 {
	r: mask
	return mask
}

texture_type ShadowDepth -> f32 {
	sample: comparison
	r: depth

	at(uv: vec2, reference: f32) -> f32
}

texture_type ShadowDepthArray -> f32 {
	sample: comparison
	layered
	r: depth

	at(uv: vec2, layer: u32, reference: f32) -> f32
}

texture_type DepthR -> f32 {
	sample: point
	r: depth
	return depth
}

struct Surf {
	position:   vec3 in world
	normal:     vec3 in world
	basis:      mat3 from tangent to world
	uv:         vec2
	uv1:        vec2
	screen:     vec2
	view_depth: f32
}

struct Pixel {
	screen: vec2
	uv:     vec2
	depth:  f32
}

@context(surf, sp)
@composition(base, material, weight)
material_properties base {
	channel @compose(mix) albedo: color = rgba(0.0, 0.0, 0.0, 1.0)
	channel @compose(mix) emissive: vec3 = vec3(0.0)
	channel @compose(mix) opacity: f32 = 1.0
}

@default_material
material_properties standard extends base {
	channel @compose(mix) roughness: f32 = 1.0
	channel @compose(mix) metallic: f32 = 0.0
	channel @compose(mix) normal: vec3 in world = sp.normal
	channel @compose(mix) normal_map: vec3 in tangent = vec3(0.0, 0.0, 1.0)
	channel @compose(mix) occlusion: f32 = 1.0
}

enum FogMode: u32 {
	off    = 0
	linear = 1
	exp2   = 2
}

enum LightKind: u32 {
	directional = 0
	point       = 1
	spot        = 2
}

struct LightData {
	position:    vec3 in world
	range:       f32
	direction:   vec3 in world
	kind:        LightKind
	color:       vec3
	intensity:   f32
	cos_inner:   f32
	cos_outer:   f32
	shadow_slot: i32
}

struct ShadowData {
	view_proj:   mat4 from world to clip
	depth_bias:  f32
	normal_bias: f32
	slice:       u32
	inv_size:    f32
}

struct LightSample {
	l:           vec3 in world
	radiance:    vec3
	attenuation: f32
}

struct MaterialSplit {
	diffuse: vec3
	f0:      vec3
}

struct CameraData {
	view_proj:     mat4 from world to clip
	inv_view_proj: mat4 from clip to world
	position:      vec3 in world
	near:          f32
	far:           f32
	exposure:      f32
	viewport:      vec2
}

struct FogData { color: vec3; density: f32; start: f32; end: f32 }

struct SH2 { coeffs: vec4[9] }

struct Cluster { offset: u32; count: u32 }

struct Splits { depth: vec4 }

struct Frustum { planes: vec4[6] }

// Unlit is an ordinary engine schema and response, not a compiler profile.
material_properties unlit extends base {}


// Surface inputs are an engine record; field names carry no compiler semantics.
struct surf {
    @semantic(coord) uv: vec2
    uv2: vec2
    @semantic(time) time: f32
    @semantic(resolution) resolution: vec2
    position: vec3
    normal: vec3
    // Billboard instance inputs. Mesh contexts supply inert defaults.
    particle_age: f32
    particle_lifespan: f32
    particle_id: f32
    particle_velocity: vec3
}
