// Engine-provided draw module: select camera_billboard in the emitter pipeline.
// State contract: position.xyz is the world center; position.w is sprite size.
// Rows of the world-to-view rotation are the camera's world-space right/up axes.
struct CameraParticleVarying {
    @semantic(position) clip_pos: vec4
    @location(0) uv: vec2
    @location(1) world_pos: vec3 in world
    @location(2) world_normal: vec3 in world
    @location(3) @interpolate(flat) particle_life: vec3
    @location(4) @interpolate(flat) particle_velocity: vec3
}

@shader pass camera_billboard for base {
    binding {
        @group(draw) @binding(0) scene: uniform<PreviewScene>
        @group(draw) @binding(3) particle_render: buffer<Particle>
        @group(draw) @binding(4) particle_slots: buffer<ParticleSlot>
    }
    stage: raster
    draw: fullscreen
    cull: choose_state(back, none, two_sided)
    depth { write: blend != SurfaceBlend.Translucent; compare: less }
    blend { all: choose_state(replace, alpha, blend == SurfaceBlend.Translucent) }

    fn face_camera(center: vec3, corner: vec2, size: f32, view: mat4) -> vec3 {
        let right = vec3(view[0].x, view[1].x, view[2].x)
        let up = vec3(view[0].y, view[1].y, view[2].y)
        return center + (right * corner.x + up * corner.y) * size
    }

    @vertex fn vertex(@builtin(vertex_index) vertex_id: u32, @builtin(instance_index) instance_id: u32) -> CameraParticleVarying {
        if particle_slots[instance_id].enabled == u32(0) {
            return CameraParticleVarying(vec4(2.0, 2.0, 2.0, 1.0), vec2(0.0), vec3(0.0), vec3(0.0), vec3(0.0, 1.0, 0.0), vec3(0.0))
        }
        let p = particle_render[instance_id]
        let corner = particle_billboard_corner(vertex_id)
        let world_pos = face_camera(p.position.xyz, corner, p.position.w, scene.view)
        let normal = vec3(scene.view[0].z, scene.view[1].z, scene.view[2].z)
        return CameraParticleVarying(
            scene.proj * scene.view * vec4(world_pos, 1.0),
            corner + vec2(0.5), world_pos, normal,
            vec3(p.age, p.lifespan, p.id), p.velocity.xyz)
    }

    fn material_context(sp: CameraParticleVarying) -> surf {
        return surf(sp.uv, sp.uv, scene.time, scene.res, sp.world_pos, sp.world_normal,
                    sp.particle_life.x, sp.particle_life.y, sp.particle_life.z, sp.particle_velocity)
    }

    // Renderer policy is authored here, including normal orientation and coverage.
    fn prepare_fragment(sp: CameraParticleVarying, front_face: bool) -> CameraParticleVarying {
        if two_sided {
            if front_face == false { return CameraParticleVarying(sp.clip_pos, sp.uv, sp.world_pos, -sp.world_normal, sp.particle_life, sp.particle_velocity) }
        }
        return sp
    }

    fn finish_fragment(result: color) -> color {
        if blend == SurfaceBlend.Masked {
            if result.a < mask_cutoff { discard_fragment() }
        }
        if blend == SurfaceBlend.Translucent { return result }
        return vec4(result.rgb, 1.0)
    }

    fn shade(sp: CameraParticleVarying, m: base) -> color {
        return evaluate_schema(material_context(sp), m)
    }

    fn particle_billboard_corner(vertex_id: u32) -> vec2 {
        let corners = [vec2(-0.5, -0.5), vec2(0.5, -0.5), vec2(-0.5, 0.5),
                       vec2(-0.5, 0.5), vec2(0.5, -0.5), vec2(0.5, 0.5)]
        return corners[vertex_id]
    }
    @evaluate(surface) fn evaluate(context: surf) -> base {}
    @fragment fn fragment(sp: CameraParticleVarying, @builtin(front_facing) front_face: bool) -> color {
        let prepared = prepare_fragment(sp, front_face)
        return finish_fragment(shade(prepared, evaluate(material_context(prepared))))
    }
}
