// Pure modules specialize to the caller's concrete state and preserve its other fields.
// Required fields are checked at each call; there is no universal particle record.
fn particle_gravity<T>(p: T, gravity: vec3, dt: f32) -> T {
    var next = p
    next.velocity = vec4(p.velocity.xyz + gravity * dt, p.velocity.w)
    return next
}

fn particle_drag<T>(p: T, rate: f32, dt: f32) -> T {
    var next = p
    next.velocity = vec4(p.velocity.xyz * exp(-max(rate, 0.0) * dt), p.velocity.w)
    return next
}

fn particle_integrate<T>(p: T, dt: f32) -> T {
    var next = p
    next.position = vec4(p.position.xyz + p.velocity.xyz * dt, p.position.w)
    return next
}

// Initialization and presentation modules preserve all other state attributes.
fn particle_fountain<T>(p: T, origin: vec3, width: f32, speed: f32, id: f32) -> T {
    let random_value = fract(sin(id * 127.1 + 31.7) * 43758.5453)
    let angle = random_value * 6.28318530718
    var next = p
    next.position = vec4(origin, 0.0)
    next.velocity = vec4(cos(angle) * width, speed + random_value * 0.65, sin(angle) * width, 0.0)
    next.lifespan = 1.2 + random_value * 0.8
    return next
}

fn particle_fade_size<T>(p: T, size: f32) -> T {
    var next = p
    next.position = vec4(p.position.xyz, size * (1.0 - p.age / p.lifespan))
    return next
}
