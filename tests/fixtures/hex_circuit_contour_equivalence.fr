// Hex circuitry: follow cell borders with traveling light.
//
// Read this as a small recipe evaluated at each pixel:
//   inset contours -> traveling lights -> thin wires + soft halos
//                  -> colored circuitry + white highlights
// A mask is a brightness value: 0 is dark, 1 is fully lit. Multiplying masks
// lights only their overlap. Adding them combines contributions before clamping.
// Change cells.every for density, or seed for colors and animation phases.

canvas hex_circuit(ctx: CanvasContext) -> color {
    let time = context(time)

    in space centered(aspect: preserve)
        .rotate(12deg)
        .cells(layout: hex, every: 0.16, seed: 73, sampling: grid4x4, cell: tile) {
        // Two paths tucked inside the cell border.
        let outer = tile.contour(inset: 0.037)
        let inner = tile.contour(inset: 0.105)

        // Match the original orbit: each cell has its own pace and starting point.
        // Angular motion keeps that look; perimeter motion also supports speed: 20px/s.
        let orbit = time * (0.12 + 0.08 * hash(tile, salt: 1)) + tile.rand
        let outer_pulse = chase(along: outer, head: orbit, tail: 0.028881133,
            motion: angular, direction: counterclockwise)
        let inner_pulse = chase(along: inner, head: orbit * 0.7, tail: 0.021660849,
            motion: angular, direction: clockwise, phase: 0.5)

        // Normalized widths keep the original proportions when the view is resized.
        // Soft width is measured across the two half-brightness points.
        let outer_core = band(outer.edge_distance, width: 0.0066014016, profile: soft)
        let outer_halo = band(outer.edge_distance, width: 0.03960841, profile: soft)
        let inner_core = band(inner.edge_distance, width: 0.0057762265, profile: soft)
        let inner_halo = band(inner.edge_distance, width: 0.030806541, profile: soft)

        let local = tile.local
        // 4. Small circuit details, also described as brightness masks.
        // Start with a horizontal line, then fade it in/out along x to leave
        // two short feeds. Distance to a radius makes a ring; two soft bands
        // multiplied together make the rectangular chip.
        let feed_lines = exp(-abs(local.y) * 220.0)
            * smoothstep(0.10, 0.13, abs(local.x))
            * (1.0 - smoothstep(0.37, 0.395, abs(local.x)))
        let contact_ring = exp(-abs(length(local) - 0.075) * 230.0)
        let chip = (1.0 - smoothstep(0.025, 0.035, abs(local.x)))
            * (1.0 - smoothstep(0.040, 0.050, abs(local.y)))
        let heartbeat = 0.5 + 0.5 * sin(time * 2.4 + tile.rand * 6.2831853)

        // 5. Light the tracks. A small constant keeps them visible between
        // pulses; multiplying by a pulse brightens just its moving segment.
        let outer_core_light = outer_core * (0.15 + outer_pulse * 1.8)
        let outer_halo_light = outer_halo * (0.025 + outer_pulse * 0.48)
        let inner_core_light = inner_core * (0.07 + inner_pulse * 0.7)
        let inner_halo_light = inner_halo * inner_pulse * 0.18
        let feed_light = feed_lines * 0.12
        let contact_light = contact_ring * (0.10 + heartbeat * 0.16)
        let colored_light = outer_core_light + outer_halo_light
            + inner_core_light + inner_halo_light + feed_light + contact_light
        let white_highlights = outer_core * outer_pulse * 0.8 + chip * heartbeat * 0.6
        let copper = mix(#16d9ec, #ffae47, step(0.78, tile.rand))

        // 6. Paint three layers: board, colored circuitry, bright highlights.
        compose {
            fill(mix(#030a14, #0a1d2a, tile.rand))
            fill(copper) |> opacity(clamp(colored_light, 0.0, 1.0))
            fill(#dcffff) |> opacity(clamp(white_highlights, 0.0, 1.0))
        }
    }
}
